rules_version = '2';

/*  U-TECH Student Tracker — Firestore security rules
 *
 *  These rules are what make the signature evidence meaningful. They run on Google's
 *  servers, so they cannot be bypassed by editing the page, the JavaScript, or the
 *  network request.
 *
 *  In short:
 *    - only registered instructors and registered students can read anything at all
 *    - a student can read ONLY his own record, and can write ONLY his own signature
 *    - a student can never approve a topic, and can never touch an approved one
 *    - a signature timestamp is always the server's clock, never the phone's
 *    - the history log can be added to, but never edited or deleted, by anyone
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function em() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }
    function isAdmin() {
      return em() != '' && exists(/databases/$(database)/documents/admins/$(em()));
    }
    function ownerOf(sid) {
      return em() != ''
        && exists(/databases/$(database)/documents/students/$(sid))
        && get(/databases/$(database)/documents/students/$(sid)).data.email == em()
        && get(/databases/$(database)/documents/students/$(sid)).data.active == true;
    }

    /* ---- who is an instructor ---- */
    match /admins/{mail} {
      allow get: if request.auth != null;          // the app checks its own address
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    /* ---- email -> student id, so a student never has to query the roll ---- */
    match /emailIndex/{mail} {
      allow get: if request.auth != null && mail == em();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    /* ---- the syllabus library ---- */
    match /syllabi/{course} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    /* ---- students ---- */
    match /students/{sid} {
      allow get: if isAdmin() || ownerOf(sid);
      allow list: if isAdmin();
      allow write: if isAdmin();

      match /logs/{lid} {
        allow read: if isAdmin() || ownerOf(sid);
        allow write: if isAdmin();
      }

      match /topics/{tid} {
        allow read: if isAdmin() || ownerOf(sid);
        allow create, delete: if isAdmin();

        allow update: if isAdmin() || (
          ownerOf(sid)
          // the record must be open: taught, and not yet approved
          && resource.data.iAck == false
          && resource.data.stage == 'Taught'
          // a student can never grant approval
          && request.resource.data.iAck == false
          // he may touch nothing except his own signature fields
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['sAck', 'sAckAt', 'sig', 'pending'])
          // the queue flag must tell the truth
          && request.resource.data.pending == request.resource.data.sAck
          // signing: the time is the server's, and a signature must be present
          && (request.resource.data.sAck == false || (
                request.resource.data.sAckAt == request.time
                && request.resource.data.sig is string
                && request.resource.data.sig.size() > 40
                && request.resource.data.sig.size() < 200000
             ))
        );
      }
    }

    /* ---- instructor-wide view of everything waiting for approval ---- */
    match /{path=**}/topics/{tid} {
      allow read: if isAdmin();
    }

    /* ---- history: append-only, for everyone, forever ---- */
    match /audit/{aid} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.actor == em()
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
  }
}
